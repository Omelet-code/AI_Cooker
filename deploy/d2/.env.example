# 形状示例，无秘密。空必需值使Compose拒绝运行；勿把真实值提交。
RELEASE_PROJECT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
COOKER_JWT_SECRET=
LLM_CREDENTIAL_MASTER_KEY=
DOMAIN=
PUBLIC_ORIGIN=
ACME_WEBROOT=
TLS_DIRECTORY=
# 镜像填写已核对repository@sha256摘要，或离线save/load后的sha256:imageID；禁止漂移tag。
POSTGRES_IMAGE=
BACKEND_IMAGE=
WEB_IMAGE=

# 默认关闭；开启须填写有效形状的百炼Key，并先运行静默render校验。
# 此Key供所有用户的query Embedding使用；不填写共享DeepSeek Key。
# DeepSeek Key由各用户在网页账户设置中保存，沿用服务端加密。
COOKER_AGENT_EXECUTION_ENABLED=false
DASHSCOPE_API_KEY=

# 演示起点，不是实测性能或收费硬配额。
REGISTER_RATE=3r/m
LOGIN_RATE=10r/m
MODEL_RATE=6r/m
REGISTER_BURST=2
LOGIN_BURST=5
MODEL_BURST=2
REGISTER_CONCURRENCY=1
LOGIN_CONCURRENCY=2
MODEL_IP_CONCURRENCY=1
MODEL_GLOBAL_CONCURRENCY=2
