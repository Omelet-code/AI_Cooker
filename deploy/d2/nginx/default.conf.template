# 只按规范化URI和真实连接地址限流，不信任客户端X-Forwarded-For。
map "$request_method:$uri" $register_key {
    default "";
    ~^POST:/api/auth/register/?$ $binary_remote_addr;
}
map "$request_method:$uri" $login_key {
    default "";
    ~^POST:/api/auth/login/?$ $binary_remote_addr;
}
map "$request_method:$uri" $model_key {
    default "";
    ~^POST:/api/conversations/[^/]+/turns/?$ $binary_remote_addr;
    ~^POST:/api/conversations/[^/]+/meals/?$ $binary_remote_addr;
    ~^POST:/api/conversations/[^/]+/meals/[^/]+/(revisions|guides)/?$ $binary_remote_addr;
}
map $model_key $model_global_key {
    "" "";
    default cooker_model_http;
}
limit_req_zone $register_key zone=register_rate:1m rate=${REGISTER_RATE};
limit_req_zone $login_key zone=login_rate:1m rate=${LOGIN_RATE};
limit_req_zone $model_key zone=model_rate:1m rate=${MODEL_RATE};
limit_conn_zone $register_key zone=register_conn:1m;
limit_conn_zone $login_key zone=login_conn:1m;
limit_conn_zone $model_key zone=model_conn:1m;
limit_conn_zone $model_global_key zone=model_global_conn:1m;
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 ${PUBLIC_ORIGIN}$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${DOMAIN};
    ssl_certificate /etc/nginx/tls/current/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    add_header X-Content-Type-Options nosniff always;
    root /usr/share/nginx/html;
    index index.html;
    location /api/ {
        limit_req zone=register_rate burst=${REGISTER_BURST} nodelay;
        limit_req zone=login_rate burst=${LOGIN_BURST} nodelay;
        limit_req zone=model_rate burst=${MODEL_BURST} nodelay;
        limit_req_status 429;
        limit_conn register_conn ${REGISTER_CONCURRENCY};
        limit_conn login_conn ${LOGIN_CONCURRENCY};
        limit_conn model_conn ${MODEL_IP_CONCURRENCY};
        limit_conn model_global_conn ${MODEL_GLOBAL_CONCURRENCY};
        limit_conn_status 429;
        # 只拒绝新请求，已接纳的长请求继续；不等于后台作业或费用配额。
        error_page 429 = @limited;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 95s;
        proxy_read_timeout 95s;
        proxy_buffering off;
        proxy_next_upstream off;
    }
    location @limited {
        default_type application/json;
        add_header Retry-After 20 always;
        return 429 '{"code":"ENTRY_RATE_LIMITED","message":"请求过于频繁，请稍后重试","data":null}';
    }
    location / { try_files $uri $uri/ /index.html; }
}
